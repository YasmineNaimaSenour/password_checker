{
  "manifest_version": 2,
  "name": "Password Strength Checker",
  "version": "1.0",
  "description": "Check the strength of your passwords in real time",
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/security16.png",
      "48": "images/security48.png",
      "128": "images/security128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "https://api.pwnedpasswords.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "estimated_cracking_time.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    "popup.html",
    "popup.js",
    "estimated_cracking_time.js"
  ],
  "icons": {
    "16": "images/security16.png",
    "48": "images/security48.png",
    "128": "images/security128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "passwordchecker@yourdomain.com"
    }
  }
}